import os
from openai import OpenAI
from dotenv import load_dotenv

load_dotenv()

client = OpenAI(api_key="Enter your apikey")

def chain_of_thought_example(question):
    prompt = f"""
Solve the following step by step.

Question: {question}

Let's think step by step.
"""

    response = client.responses.create(
        model="gpt-4.1-mini",   # ✅ updated working model
        input=prompt
    )

    return response.output[0].content[0].text


def few_shot_classification(text):
    prompt = f"""
Classify the sentiment of the text.

Examples:
Text: I love this product!
Sentiment: Positive

Text: This is the worst experience ever.
Sentiment: Negative

Text: The service was okay, not great.
Sentiment: Neutral

Now classify:
Text: {text}
Sentiment:
"""

    response = client.responses.create(
        model="gpt-4.1-mini",
        input=prompt
    )

    return response.output[0].content[0].text


if __name__ == "__main__":
    # Chain-of-Thought
    print("=== Chain-of-Thought ===")
    question = "A train travels 60 km in 1 hour. How far in 5 hours?"
    print(chain_of_thought_example(question))

    # Few-Shot Learning
    print("\n=== Few-Shot Learning ===")
    text = "I am very happy with this service."
    print(few_shot_classification(text))


